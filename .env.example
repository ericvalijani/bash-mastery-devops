# .env.example — template for the local .env file.
#
# Copy to .env and fill in real values:
#     cp .env.example .env
#
# .env is listed in .gitignore and must never be committed. If git is already
# tracking it, the ignore rule has no effect until you untrack it:
#     git rm --cached .env

# Environment name: dev | staging | prod
APP_ENV=

# Deployment target
TARGET_HOST=
TARGET_PORT=

# Credentials — never commit real values
API_KEY=
DB_PASS=
SSH_KEY=
